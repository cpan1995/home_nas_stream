+++ b/src/client/src/components/player/hooks/useAnimeServers.ts
@@ -0,0 +1,31 @@
+import { useEffect, useState } from "react"
+import { animeServerSources } from "@/lib/screening-room"
+import type { UnifiedMedia } from "../types/media.types"
+
+export function useAnimeServers(media: Pick<UnifiedMedia, "id" | "type" | "seasonNumber" | "episodeNumber">) {
+    const { id, type, seasonNumber, episodeNumber } = media
+    const key = `${type}:${id}:${seasonNumber}:${episodeNumber}`
+    const [attempt, retry] = useState(0)
+    const [result, setResult] = useState({ key: "", sources: [] as ReturnType<typeof animeServerSources>, loading: true, error: "" })
+    useEffect(() => {
+        if (!id) { setResult({ key, sources: [], loading: false, error: "" }); return }
+        const controller = new AbortController()
+        setResult({ key, sources: [], loading: true, error: "" })
+        const timeout = setTimeout(() => controller.abort(), 18000)
+        let active = true
+        void (async () => {
+            try {
+                const query = type === "tv" ? `?season=${seasonNumber ?? 1}&episode=${episodeNumber ?? 1}` : ""
+                const response = await fetch(`/api/anime/resolve/${type}/${encodeURIComponent(id)}${query}`, { signal: controller.signal })
+                if (!response.ok) throw Error("Anime servers could not be checked. Try again.")
+                const { match } = await response.json()
+                const sources = match ? animeServerSources(match.anilistId, match.episode) : []
+                if (active) setResult({ key, sources, loading: false, error: "" })
+            } catch {
+                if (active) setResult({ key, sources: [], loading: false, error: "Anime servers could not be checked. Try again." })
+            } finally { clearTimeout(timeout) }
+        })()
+        return () => { active = false; clearTimeout(timeout); controller.abort() }
+    }, [key, id, type, seasonNumber, episodeNumber, attempt])
+    return { ...(result.key === key ? result : { sources: [], loading: true, error: "" }), retry: () => retry(n => n + 1) }
+}
diff --git a/src/client/src/components/player/hooks/useEpisodeGuide.ts b/src/client/src/components/player/hooks/useEpisodeGuide.ts
new file mode 100644
index 0000000..c8506b2
--- /dev/null
+++ b/src/client/src/components/player/hooks/useEpisodeGuide.ts
@@ -0,0 +1,57 @@
+import { useEffect, useState } from 'react'
+
+export type Episode = { season: number; number: number; name: string; airDate: string; available: boolean }
+export type Season = { number: number; name: string }
+type Guide = { key: string; episodes: Episode[]; seasons: Season[]; next: Episode[]; loading: boolean; error: string }
+const metadata = new Map<string, { at: number; value: any }>()
+async function get(path: string, signal: AbortSignal) {
+    const cached = metadata.get(path)
+    if (cached && Date.now() - cached.at < 120000) return cached.value
+    const response = await fetch(`/api/tmdb/3/${path}`, { signal })
+    if (!response.ok) throw Error('Episodes could not be loaded.')
+    const value = await response.json()
+    if (metadata.size >= 30) metadata.delete(metadata.keys().next().value!)
+    metadata.set(path, { at: Date.now(), value })
+    return value
+}
+const rows = (value: any, season: number): Episode[] => (Array.isArray(value?.episodes) ? value.episodes : [])
+    .filter((e: any) => Number.isSafeInteger(e.episode_number) && e.episode_number > 0)
+    .map((e: any) => ({ season, number: e.episode_number, name: String(e.name || `Episode ${e.episode_number}`), airDate: String(e.air_date || ''),
+        available: !e.air_date || e.air_date <= new Date().toISOString().slice(0, 10) }))
+    .sort((a: Episode, b: Episode) => a.number - b.number)
+
+export function useEpisodeGuide(id: string, season: number, episode: number, enabled = true) {
+    const key = `${id}:${season}:${episode}:${enabled}`
+    const [attempt, setAttempt] = useState(0)
+    const empty: Guide = { key, episodes: [], seasons: [], next: [], loading: enabled, error: '' }
+    const [state, setState] = useState<Guide>(empty)
+    useEffect(() => {
+        if (!enabled || !id) return
+        let active = true
+        const controller = new AbortController(), timer = setTimeout(() => controller.abort(), 15000)
+        setState({ key, episodes: [], seasons: [], next: [], loading: true, error: '' })
+        void (async () => {
+            try {
+                const [show, details] = await Promise.all([get(`tv/${id}`, controller.signal), get(`tv/${id}/season/${season}`, controller.signal)])
+                const seasons: Season[] = (Array.isArray(show.seasons) ? show.seasons : [])
+                    .filter((s: any) => Number.isSafeInteger(s.season_number) && s.season_number > 0 && s.episode_count > 0)
+                    .map((s: any) => ({ number: s.season_number, name: String(s.name || `Season ${s.season_number}`) }))
+                    .sort((a: Season, b: Season) => a.number - b.number)
+                if (!seasons.some(s => s.number === season)) seasons.push({ number: season, name: `Season ${season}` })
+                const episodes = rows(details, season)
+                const next = episodes.filter(e => e.number > episode && e.available).slice(0, 2)
+                // Only fetch one adjacent season's metadata at the boundary.
+                const following = seasons.find(s => s.number > season)
+                if (next.length < 2 && following) {
+                    try { next.push(...rows(await get(`tv/${id}/season/${following.number}`, controller.signal), following.number).filter(e => e.available).slice(0, 2 - next.length)) }
+                    catch { /* Keep the current season usable if the next season cannot load. */ }
+                }
+                if (active) setState({ key, episodes, seasons, next, loading: false, error: '' })
+            } catch {
+                if (active) setState({ key, episodes: [], seasons: [], next: [], loading: false, error: 'Episodes could not be loaded. Try again.' })
+            } finally { clearTimeout(timer) }
+        })()
+        return () => { active = false; controller.abort(); clearTimeout(timer) }
+    }, [key, id, season, episode, enabled, attempt])
+    return { ...(state.key === key ? state : empty), retry: () => setAttempt(n => n + 1) }
+}
diff --git a/src/client/src/lib/local-api.ts b/src/client/src/lib/local-api.ts
new file mode 100644
index 0000000..ecb7805
--- /dev/null
+++ b/src/client/src/lib/local-api.ts
@@ -0,0 +1,13 @@
+// Keep the installed Core/TMDB credentials on the local server.
+// The upstream TMDB SDK has no custom transport option.
+if (import.meta.env.VITE_LOCAL_API === "true") {
+    const nativeFetch = globalThis.fetch.bind(globalThis)
+    globalThis.fetch = (input, init) => {
+        const url = new URL(input instanceof Request ? input.url : String(input), location.href)
+        if (url.origin !== "https://api.themoviedb.org") return nativeFetch(input, init)
+        url.searchParams.delete("api_key")
+        const headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined))
+        headers.delete("Authorization")
+        return nativeFetch(`/api/tmdb${url.pathname}${url.search}`, { ...init, headers })
+    }
+}
diff --git a/src/client/src/lib/screening-room.ts b/src/client/src/lib/screening-room.ts
new file mode 100644
index 0000000..325d879
--- /dev/null
+++ b/src/client/src/lib/screening-room.ts
@@ -0,0 +1,84 @@
+// A session-local mode: the standalone CinePro site keeps its provider settings.
+const requested = new URLSearchParams(location.search).get("screeningRoom")
+if (requested === "1") sessionStorage.setItem("screeningRoom", "1")
+export const screeningRoom = sessionStorage.getItem("screeningRoom") === "1"
+
+export function moviesApiUrl(id: string, season?: number, episode?: number) {
+    if (!/^[1-9]\d*$/.test(id)) throw Error("Invalid movie ID")
+    let path = `/movie/${id}`
+    if (season !== undefined || episode !== undefined) {
+        if (!Number.isSafeInteger(season) || !Number.isSafeInteger(episode) || season! < 1 || episode! < 1)
+            throw Error("Invalid season or episode")
+        path = `/tv/${id}/${season}/${episode}`
+    }
+    return `https://moviesapi.to${path}?theme=064be4`
+}
+
+
+// Documented embed endpoints; a listed server is not a playback availability check.
+export const screeningServers = [
+    { id: "moviesapi", name: "MoviesAPI", origin: "https://moviesapi.to" },
+    { id: "vidlink", name: "VidLink", origin: "https://vidlink.pro" },
+    { id: "vidfast", name: "VidFast", origin: "https://vidfast.vc" },
+    { id: "cinezo", name: "Cinezo", origin: "https://player.cinezo.live" },
+    { id: "rivestream", name: "Rivestream", origin: "https://www.rivestream.app" },
+    { id: "anixo", name: "AniXo", origin: "https://anixo.buzz" },
+    { id: "supaplay", name: "SupaPlay", origin: "https://supaplay.fun" },
+    { id: "megaplay", name: "MegaPlay", origin: "https://megaplay.buzz" },
+    { id: "animeplayer", name: "Anime Player", origin: "https://ani.megaplay.su" },
+    { id: "dropfile", name: "DropFile", origin: "https://dropfile.cc" },
+    { id: "anilink", name: "AniLink", origin: "https://anilink.cc" },
+    { id: "tryembed", name: "TryEmbed", origin: "https://tryembed.us.cc" },
+    { id: "cinextream", name: "CineXtream", origin: "https://cinextream.cc" },
+    { id: "nontongo", name: "Nontongo", origin: "https://nontongo.win" },
+    { id: "4animo", name: "4Animo", origin: "https://cdn.4animo.xyz" },
+    { id: "miruro", name: "Miruro", origin: location.origin },
+] as const
+export function screeningServerSources(id: string, season?: number, episode?: number) {
+    const moviesApi = new URL(moviesApiUrl(id, season, episode)) // Shared validation for movie/episode IDs.
+    const riveQuery = new URLSearchParams({ type: season === undefined ? "movie" : "tv", id })
+    if (season !== undefined) { riveQuery.set("season", String(season)); riveQuery.set("episode", String(episode)) }
+    return screeningServers.filter(server => ["moviesapi", "vidlink", "vidfast", "cinezo", "rivestream"].includes(server.id)).map(server => ({
+        url: server.id === "moviesapi" ? moviesApi.href : server.id === "rivestream" ? `${server.origin}/embed?${riveQuery}` : server.id === "cinezo" ? `${server.origin}/embed${moviesApi.pathname}?autoplay=false` : `${server.origin}${moviesApi.pathname}?autoplay=false&title=false`,
+        type: "embed" as const, quality: "unknown", audioTracks: [], provider: { id: server.id, name: server.name },
+    }))
+}
+export function isScreeningServer(url: string) {
+    try { return screeningServers.some(server => server.origin === new URL(url).origin && (server.id !== "miruro" || /^\/anime-player\/[1-9]\d*\/[1-9]\d*\/(sub|dub)$/.test(new URL(url).pathname))) } catch { return false }
+}
+
+export function animeServerSources(anilistId: number, episode: number) {
+    if (![anilistId, episode].every(n => Number.isSafeInteger(n) && n > 0)) throw Error("Invalid anime episode")
+    return screeningServers.filter(s => ["anixo", "megaplay", "animeplayer", "dropfile", "miruro", "cinezo", "supaplay", "anilink", "tryembed", "cinextream", "nontongo", "4animo"].includes(s.id)).flatMap(server =>
+        (server.id === "nontongo" ? ["sub"] as const : ["sub", "dub"] as const).map(language => ({
+            url: server.id === "anilink" ? `${server.origin}/watch/${anilistId}/${episode}?variant=${language}&autoplay=1` :
+                server.id === "tryembed" ? `${server.origin}/embed/anime/${anilistId}/${episode}/${language}` :
+                server.id === "cinextream" ? `${server.origin}/api/embed/anime/${language}/${anilistId}/${episode}?color=064be4` :
+                server.id === "nontongo" ? `${server.origin}/anime/${anilistId}/${episode}/play` :
+                server.id === "4animo" ? `${server.origin}/embed/ani/${anilistId}/${episode}/${language}` :
+                server.id === "anixo" ? `${server.origin}/embed/ani/${anilistId}/${episode}/${language}?autoplay=false` :
+                server.id === "miruro" ? `${server.origin}/anime-player/${anilistId}/${episode}/${language}` :
+                server.id === "animeplayer" ? `${server.origin}/ani/${anilistId}/${episode}/${language}` :
+                server.id === "dropfile" ? `${server.origin}/player/tv/anilist-${anilistId}/1/${episode}?audio=${language}&lang=en&autoplay=0` :
+                ["supaplay", "megaplay"].includes(server.id) ? `${server.origin}/stream/ani/${anilistId}/${episode}/${language}` :
+                `${server.origin}/embed/anime/${anilistId}/${episode}?dub=${language === "dub"}&autoplay=false`,
+            type: "embed" as const, quality: "unknown", audioTracks: [],
+            provider: { id: server.id === "nontongo" ? "nontongo-anime" : `${server.id}-anime-${language}`, name: server.id === "nontongo" ? "Nontongo · Anime" : `${server.name} · Anime ${language}` },
+        })))
+}
+
+// Live checked 2026-09-06. Retain integrations but don't load known wrong-title
+// routes. Recheck the documented endpoints before clearing either issue.
+export function screeningServerIssue(providerId: string): string | undefined {
+    if (providerId.startsWith("cinezo-anime-")) return "Unavailable: anime route opens a demo"
+    if (providerId.startsWith("supaplay-anime-")) return "Unavailable: anime matching returned a different title"
+}
+
+// Keep unverified providers available for manual selection without spending Auto's
+// preparation budget or treating an unknown audio variant as a verified sub/dub.
+export function screeningManualFallback(providerId: string) {
+    // Only this new variant passed native decode + pause/seek/volume checks.
+    // Auto still verifies each episode's actual frames before selecting it.
+    if (providerId === "tryembed-anime-sub") return false
+    return ["anilink", "tryembed", "cinextream", "nontongo", "4animo"].some(id => providerId.startsWith(`${id}-anime`))
+}
