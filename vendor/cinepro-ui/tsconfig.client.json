{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./build/client",
        "rootDir": "./src/client/src",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "target": "ES2020",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/client/src/*"
            ],
            "@/app": [
                "src/client/src/app"
            ],
            "@/features/*": [
                "src/client/src/features/*"
            ],
            "@/shared/*": [
                "src/client/src/shared/*"
            ]
        },
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/client/src/**/*",
        "src/client/vite-env.d.ts"
    ],
    "exclude": [
        "src/server/**/*",
        "src/**/*.test.ts"
    ]
}
