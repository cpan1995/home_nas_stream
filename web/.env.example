# Docker host port and exact browser origin (use localhost consistently).
WEB_PORT=5180
APP_ORIGIN=http://localhost:5180
TRUST_PROXY=false
# Public signup is closed; existing accounts can still log in.
SIGNUP_ENABLED=false

# Generated automatically by: node scripts/setup-env.mjs
# Use URL-safe characters if setting manually; keep this file private.
POSTGRES_PASSWORD=

# For npm run dev outside Docker only: point to your PostgreSQL server.
# Compose supplies DATABASE_URL using its private db network.
DATABASE_URL=
PORT=5180
HOST=127.0.0.1
ALLOWED_HOSTS=http://localhost:5180

# Optional Google OAuth Web application client.
# Authorized redirect URI: http://localhost:5180/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty allows Google signup; set a list to restrict Google identities only.
GOOGLE_ALLOWED_EMAILS=

# Streaming endpoints and credentials live in ../.local/stream-providers.env.
# Create it with: node ../scripts/configure-streams.mjs --init
