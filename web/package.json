{
    "name": "cinepro-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "tsx src/server/index.ts --dev",
        "start": "cross-env NODE_ENV=production node build/server/index.js",
        "build": "npm run build:client && npm run build:server",
        "build:client": "dotenv -e .env -- vite build",
        "format": "prettier --write .",
        "build:server": "dotenv -e .env -- tsc -p tsconfig.server.json",
        "test": "tsx --test",
        "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit"
    },
